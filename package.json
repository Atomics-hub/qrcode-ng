{
  "name": "qrcode-ng",
  "description": "Maintained drop-in for qrcode: same API, 2 tiny dependencies, logo support, ESM browser build and bundled types",
  "version": "1.6.0",
  "author": "Ryan Day <soldair@gmail.com>",
  "contributors": [
    "Vincenzo Greco <greco.vincenzo@gmail.com>",
    "Linus Unneb\u00e4ck <linus@folkdatorn.se>",
    "Atomics-hub"
  ],
  "keywords": [
    "qr",
    "code",
    "canvas",
    "qrcode",
    "qr code",
    "logo",
    "svg",
    "png",
    "esm"
  ],
  "main": "./lib/index.js",
  "types": "./index.d.ts",
  "browser": {
    "./lib/index.js": "./lib/browser.js",
    "fs": false
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "browser": {
        "import": "./build/qrcode.esm.js",
        "default": "./lib/browser.js"
      },
      "default": "./lib/index.js"
    },
    "./lib/*.js": "./lib/*.js",
    "./lib/*": "./lib/*.js",
    "./helper/*.js": "./helper/*.js",
    "./helper/*": "./helper/*.js",
    "./build/*": "./build/*",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "build",
    "lib",
    "helper",
    "index.d.ts"
  ],
  "homepage": "https://github.com/Atomics-hub/qrcode-ng",
  "license": "MIT",
  "scripts": {
    "lint": "standard",
    "test": "node --throw-deprecation test.js",
    "build": "node scripts/build.mjs",
    "prepublishOnly": "npm run build",
    "browser": "node examples/clientsideserver.js"
  },
  "bin": {
    "qrcode": "./bin/qrcode"
  },
  "dependencies": {
    "dijkstrajs": "^1.0.1",
    "pngjs": "^5.0.0"
  },
  "devDependencies": {
    "canvas": "^2.8.0",
    "canvasutil": "0.0.4",
    "colors": "^1.4.0",
    "express": "^4.17.1",
    "htmlparser2": "^4.1.0",
    "sinon": "^9.0.2",
    "standard": "^16.0.4",
    "tap": "^16.2.0",
    "esbuild": "^0.28.2",
    "jsqr": "^1.4.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Atomics-hub/qrcode-ng.git"
  },
  "bugs": {
    "url": "https://github.com/Atomics-hub/qrcode-ng/issues"
  },
  "engines": {
    "node": ">=18.3.0"
  },
  "standard": {
    "ignore": [
      "build/",
      "examples/vendors/",
      "lib/core/regex.js",
      "index.d.ts"
    ]
  }
}
